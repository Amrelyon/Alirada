# Optional Firebase client overrides (used when firebase-applet-config.json is excluded from public git)
# In GitHub Actions, set either FIREBASE_APPLET_CONFIG or these VITE_FIREBASE_* variables as Secrets.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_DATABASE_ID=""

# APP_URL: The URL where this applet is hosted (optional).
APP_URL="MY_APP_URL"

