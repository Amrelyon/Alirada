    "Profile": {
      "title": "Profile",
      "description": "Public cooperative member profile mapped to immutable Universal ID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "universal_id": { "type": "string", "minLength": 5, "maxLength": 32, "pattern": "^UID-[0-9]+$" },
        "full_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "entity_type": { "type": "string", "enum": ["Individual", "Family", "Organization", "Governmental", "Charity / Vulnerable Entity"] },
        "country": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 80 },
        "profile_image_url": { "type": "string", "maxLength": 512 },
        "image_verified_status": { "type": "string", "enum": ["Pending", "Verified", "Flagged"] },
        "user_status": { "type": "string", "enum": ["Active", "Warning", "Frozen", "Blocked"] },
        "penalty_score": { "type": "number" },
        "carried_balance": { "type": "number" },
        "absent_period_days": { "type": "integer" },
        "last_active_at": { "type": "string", "maxLength": 64 },
        "created_at": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "universal_id", "full_name", "entity_type", "profile_image_url", "image_verified_status", "user_status", "penalty_score", "carried_balance", "absent_period_days", "created_at"]
